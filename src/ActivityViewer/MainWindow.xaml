<Window x:Class="ActivityViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:ActivityViewer"
        xmlns:tabs="clr-namespace:ActivityViewer.Tabs"
        Title="Vikings Activity Viewer" Width="1400" Height="840" MinWidth="1050" MinHeight="620" WindowStartupLocation="CenterScreen"
        Icon="app.ico" Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI" FontSize="13"
        Loaded="OnLoaded" Closing="OnClosing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Background="{StaticResource HeaderBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,10">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource GhostIconButton}" Content="&#xE713;" FontSize="16"
                        Click="OnSettings" ToolTip="{l:T main.settings}" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Vikings Activity Viewer" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock x:Name="DatabaseName" Foreground="{StaticResource MutedBrush}" FontSize="14" VerticalAlignment="Center" Margin="10,0,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border x:Name="Sidebar" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16,16,16,16">
                        <TextBlock Text="{l:T sidebar.source}" Style="{StaticResource SectionLabel}" />

                        <TextBlock Text="{l:T sidebar.server}" Style="{StaticResource FieldLabel}" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE70F;" Margin="6,0,0,0"
                                    Click="OnManageProfiles" ToolTip="{l:T sidebar.manageServers}" />
                            <ComboBox x:Name="ProfileBox" DisplayMemberPath="Name" SelectionChanged="OnProfileChanged" />
                        </DockPanel>

                        <TextBlock Text="{l:T sidebar.world}" Style="{StaticResource FieldLabel}" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE72C;" Margin="6,0,0,0"
                                    Click="OnListWorlds" ToolTip="{l:T sidebar.listWorlds}" />
                            <ComboBox x:Name="WorldBox" SelectionChanged="OnWorldChanged" />
                        </DockPanel>

                        <DockPanel Margin="0,12,0,0">
                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE838;" Margin="6,0,0,0"
                                    Click="OnOpenLocal" ToolTip="{l:T main.openLocal}" />
                            <Button Click="OnRefresh" ToolTip="{l:T sidebar.downloadHint}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE896;" Style="{StaticResource IconGlyph}" />
                                    <TextBlock Text="{l:T sidebar.download}" />
                                </StackPanel>
                            </Button>
                        </DockPanel>
                        <TextBlock x:Name="CopyInfo" Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Text="{l:T sidebar.noDatabase}" />

                        <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,18,0,16" />

                        <TextBlock Text="{l:T sidebar.filters}" Style="{StaticResource SectionLabel}" />

                        <TextBlock Text="{l:T main.player}" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="PlayerBox" IsEditable="True" IsTextSearchEnabled="True" />

                        <Grid Margin="0,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{l:T main.from}" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="FromBox" ToolTip="{l:T main.fromHint}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{l:T main.to}" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="ToBox" ToolTip="{l:T main.toHint}" />
                            </StackPanel>
                        </Grid>

                        <Button Style="{StaticResource AccentButton}" Click="OnAnalyze" Margin="0,16,0,0" Padding="12,7" ToolTip="{l:T main.analyzeHint}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE768;" Style="{StaticResource IconGlyph}" />
                                <TextBlock Text="{l:T main.analyze}" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource LinkButton}" Content="{l:T main.clearFilters}" Click="OnClearFilters" Margin="0,8,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TabControl x:Name="Tabs" Margin="14,14,14,0">
                    <TabItem x:Name="DamageTabItem">
                        <tabs:DamageTab x:Name="DamagePage" />
                    </TabItem>
                    <TabItem x:Name="ItemsTabItem">
                        <tabs:ItemsTab x:Name="ItemsPage" />
                    </TabItem>
                    <TabItem x:Name="FrequencyTabItem">
                        <tabs:FrequencyTab x:Name="FrequencyPage" />
                    </TabItem>
                    <TabItem x:Name="SpeedTabItem">
                        <tabs:SpeedTab x:Name="SpeedPage" />
                    </TabItem>
                    <TabItem x:Name="InteractionsTabItem">
                        <tabs:InteractionsTab x:Name="InteractionsPage" />
                    </TabItem>
                </TabControl>

                <Border Grid.Row="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,10,0,0" Padding="14,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="StatusText" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <ProgressBar x:Name="BusyBar" Grid.Column="1" Width="200" Height="6" Margin="10,0" Visibility="Collapsed" />
                        <Button x:Name="CancelButton" Grid.Column="2" Content="{l:T common.cancel}" Click="OnCancel" IsEnabled="False" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
