<Window x:Class="ActivityViewer.Windows.PasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:ActivityViewer"
        Title="{l:T password.title}" SizeToContent="WidthAndHeight" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Icon="/app.ico" Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI" FontSize="13">
    <StackPanel Margin="16" Width="360">
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" Margin="0,0,0,10" />
        <PasswordBox x:Name="PasswordInput" />
        <CheckBox x:Name="SaveCheck" Content="{l:T common.savePassword}" IsChecked="True" Margin="0,10,0,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="OK" IsDefault="True" Style="{StaticResource AccentButton}" Click="OnOk" Width="90" />
            <Button Content="{l:T common.cancel}" IsCancel="True" Width="90" Margin="8,0,0,0" />
        </StackPanel>
    </StackPanel>
</Window>
